#!/bin/sh
# Sign off native checks for the current commit.
#
#   scripts/signoff [--dry-run] [--skip "reason"] <check>... | all
#
# Checks:
#   claude-cli       e2e/claude-cli       validate, test, lint + real Claude TUI in tmux
#   claude-desktop   manual/claude-desktop guided check in Claude Desktop
set -eu

ALL="claude-cli claude-desktop"
root=$(git rev-parse --show-toplevel)
cd "$root"

dry=0
skip=""
while [ $# -gt 0 ]; do
	case "$1" in
	--dry-run) dry=1; shift ;;
	--skip) skip="${2:-}"; [ -n "$skip" ] || { echo "--skip needs a reason" >&2; exit 2; }; shift 2 ;;
	-*) echo "unknown flag $1" >&2; exit 2 ;;
	*) break ;;
	esac
done
[ $# -gt 0 ] || { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
# shellcheck disable=SC2086
[ "$1" = all ] && set -- $ALL

sha=$(git rev-parse HEAD)
repo=""
[ $dry = 1 ] || repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)

dirty=$(git status --porcelain --untracked-files=no; git ls-files --others --exclude-standard -- '*.ts' '*.tsx' '*.json' '*.jsonc' 'hooks/*' 'scripts/*')
if [ -n "$dirty" ]; then
	echo "working tree differs from $sha:" >&2
	echo "$dirty" >&2
	[ $dry = 1 ] || exit 1
	echo "(dry run: continuing)" >&2
fi
if [ $dry = 0 ] && ! gh api "repos/$repo/commits/$sha" --silent 2>/dev/null; then
	echo "$sha is not on GitHub; push it first" >&2
	exit 1
fi

post() { # context state description
	desc=$(printf '%s' "$3" | cut -c1-140)
	echo "$1: $2 ($desc)"
	[ $dry = 1 ] && return
	gh api -X POST "repos/$repo/statuses/$sha" -f state="$2" -f context="$1" -f description="$desc" --silent
}

wait_for() { # socket text seconds
	end=$(( $(date +%s) + $3 ))
	while [ "$(date +%s)" -lt "$end" ]; do
		if tmux -L "$1" capture-pane -p -t e2e -S -200 2>/dev/null | grep -qF "$2"; then
			return 0
		fi
		sleep 0.25
	done
	echo "screen never showed: $2" >&2
	tmux -L "$1" capture-pane -p -t e2e -S -200 >&2 || true
	return 1
}

run_cli() {
	command -v claude >/dev/null || { post e2e/claude-cli failure "claude not found"; return 1; }
	command -v tmux >/dev/null || { post e2e/claude-cli failure "tmux not installed"; return 1; }
	ver=$(claude --version 2>/dev/null | head -1 | tr -s ' ' | cut -c1-60)
	claude plugin validate .
	claude plugin test .
	npx --yes @biomejs/biome@2.5.15 lint --error-on-warnings

	vhome=$(cd "$(mktemp -d)" && pwd -P)
	sock="cc-pr-tracker-e2e-$$"
	api_pid=""
	cleanup() {
		[ -z "$api_pid" ] || kill "$api_pid" 2>/dev/null || true
		tmux -L "$sock" kill-server 2>/dev/null || true
		sleep 0.5
		rm -rf "$vhome"
	}
	trap cleanup EXIT INT TERM
	mkdir -p "$vhome/.claude"
	printf '{"hasCompletedOnboarding":true,"theme":"dark","customApiKeyResponses":{"approved":["fixture-local-only"],"rejected":[]},"projects":{"%s":{"hasTrustDialogAccepted":true,"hasCompletedProjectOnboarding":true}}}\n' "$root" >"$vhome/.claude/.claude.json"
	cp "$vhome/.claude/.claude.json" "$vhome/.claude.json"

	python3 -u -c '
import http.server, socketserver
class H(http.server.BaseHTTPRequestHandler):
    def do_GET(s): s.send_response(200); s.send_header("Content-Type","application/json"); s.end_headers(); s.wfile.write(b"{}")
    def do_POST(s): s.do_GET()
    def log_message(s, *a): pass
srv = socketserver.TCPServer(("127.0.0.1", 0), H)
open("'"$vhome"'/api.url", "w").write(f"http://127.0.0.1:{srv.server_address[1]}")
srv.serve_forever()
' &
	api_pid=$!
	while [ ! -s "$vhome/api.url" ]; do sleep 0.05; done
	api_url=$(cat "$vhome/api.url")

	tmux -L "$sock" -f /dev/null new-session -d -s e2e -x 150 -y 40 -c "$root" \; set-option remain-on-exit on \; respawn-pane -k \
		env -i HOME="$vhome" CLAUDE_CONFIG_DIR="$vhome/.claude" TERM=xterm-256color \
		ANTHROPIC_API_KEY=fixture-local-only ANTHROPIC_BASE_URL="$api_url" \
		CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_AUTOUPDATER=1 \
		PATH="$root/docs/record:$PATH" \
		claude --plugin-dir "$root" --setting-sources user --strict-mcp-config --mcp-config '{"mcpServers":{}}'

	if ! wait_for "$sock" "❯" 30; then
		cleanup; trap - EXIT INT TERM
		post e2e/claude-cli failure "$ver: prompt did not start"
		return 1
	fi
	tmux -L "$sock" send-keys -t e2e -l "https://github.com/acme/storefront/pull/412"
	sleep 0.3
	tmux -L "$sock" send-keys -t e2e Enter
	if ! wait_for "$sock" "Add saved carts to the checkout page" 15; then
		cleanup; trap - EXIT INT TERM
		post e2e/claude-cli failure "$ver: PR band did not render"
		return 1
	fi
	tmux -L "$sock" send-keys -t e2e C-u
	tmux -L "$sock" send-keys -t e2e -l "/prs"
	sleep 0.3
	tmux -L "$sock" send-keys -t e2e Enter
	if ! wait_for "$sock" "cc-pr-tracker: storefront#412 · clean · approved · ✓12" 15; then
		cleanup; trap - EXIT INT TERM
		post e2e/claude-cli failure "$ver: /prs output did not render"
		return 1
	fi
	cleanup; trap - EXIT INT TERM
	post e2e/claude-cli success "$ver: validate + unit + tmux TUI passed"
}

run_desktop() {
	ver=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "/Applications/Claude.app/Contents/Info.plist" 2>/dev/null || true)
	ver="Claude ${ver:-Desktop}"
	open -a Claude "claude://code/new?folder=$root&source=services" 2>/dev/null || true
	printf '  In Claude Desktop (%s), verify cc-pr-tracker loads and /prs responds. Passed? [y/n] ' "$ver" >/dev/tty
	read -r reply </dev/tty
	if [ "$reply" = y ] || [ "$reply" = Y ]; then
		post manual/claude-desktop success "$ver: manual check passed"
	else
		post manual/claude-desktop failure "$ver: manual check failed"
		return 1
	fi
}

rc=0
for check in "$@"; do
	case "$check" in
	claude-cli) ctx=e2e/claude-cli ;;
	claude-desktop) ctx=manual/claude-desktop ;;
	*) echo "unknown check $check (checks: $ALL)" >&2; exit 2 ;;
	esac
	if [ -n "$skip" ]; then
		post "$ctx" success "skipped: $skip"
		continue
	fi
	echo "== $check"
	case "$check" in
	claude-cli) run_cli ;;
	claude-desktop) run_desktop ;;
	esac || rc=1
done
exit $rc
